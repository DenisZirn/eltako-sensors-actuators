+            filtered = raw
+        else:
+            filtered = (self._temperature_ema_alpha * raw) + ((1.0 - self._temperature_ema_alpha) * self._temperature_ema_value)
+        self._temperature_ema_value = filtered
+        return round(filtered, 2)
